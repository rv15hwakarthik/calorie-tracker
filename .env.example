# Copy to .env and fill in after creating your Supabase project (Module 2).
EXPO_PUBLIC_SUPABASE_URL=https://your-project.supabase.co
EXPO_PUBLIC_SUPABASE_ANON_KEY=your-anon-key

# AI food estimates use a Supabase Edge Function. Set this secret in Supabase, not in .env:
# Get a key from https://aistudio.google.com/apikey (new keys start with AQ.)
# If requests fail with 401, open the key in AI Studio → Add restrictions → Restrict to Gemini API
# Optional override (defaults try gemini-3.5-flash-lite, then gemini-3.8-flash):
# npx supabase secrets set GEMINI_MODEL=gemini-3.5-flash-lite
# npx supabase secrets set GEMINI_API_KEY=your-key-here
# npx supabase functions deploy estimate-food
